<idea-plugin>
  <id>com.scode.jetbrains</id>
  <name>S-Code</name>
  <vendor>S-Code</vendor>
  <description>Local-first coding agent client for the S-Code execution plane.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <group id="SCode.Actions" text="S-Code" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="SCode.Connect" class="com.scode.jetbrains.ConnectAction" text="Connect to Daemon"/>
      <action id="SCode.SendContext" class="com.scode.jetbrains.SendContextAction" text="Send Editor Context"/>
      <action id="SCode.Ask" class="com.scode.jetbrains.AskAction" text="Ask Agent"/>
    </group>
  </actions>
</idea-plugin>
