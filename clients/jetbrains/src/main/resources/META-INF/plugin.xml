<idea-plugin>
  <id>com.opencoding.jetbrains</id>
  <name>Opencoding Community</name>
  <vendor>Opencoding</vendor>
  <description>Local-first coding agent client for the Opencoding Community execution plane.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <group id="Opencoding.Actions" text="Opencoding" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Opencoding.Connect" class="com.opencoding.jetbrains.ConnectAction" text="Connect to Daemon"/>
      <action id="Opencoding.SendContext" class="com.opencoding.jetbrains.SendContextAction" text="Send Editor Context"/>
      <action id="Opencoding.Ask" class="com.opencoding.jetbrains.AskAction" text="Ask Agent"/>
    </group>
  </actions>
</idea-plugin>
