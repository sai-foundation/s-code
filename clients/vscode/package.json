{
  "name": "s-code",
  "displayName": "S-Code",
  "description": "Local-first coding agent client for the S-Code execution plane",
  "version": "0.1.0-preview.1",
  "publisher": "s-code",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:s-code.connect",
    "onCommand:s-code.createSession",
    "onCommand:s-code.ask",
    "onCommand:s-code.selectSession",
    "onCommand:s-code.reviewDiff",
    "onCommand:s-code.reviewHunks",
    "onCommand:s-code.approve",
    "onCommand:s-code.reject",
    "onCommand:s-code.openWeb"
  ],
  "contributes": {
    "commands": [
      {
        "command": "s-code.connect",
        "title": "S-Code: Connect to Daemon"
      },
      {
        "command": "s-code.createSession",
        "title": "S-Code: Create Team Session"
      },
      {
        "command": "s-code.selectSession",
        "title": "S-Code: Select Shared Session"
      },
      {
        "command": "s-code.ask",
        "title": "S-Code: Ask Agent with Editor Context"
      },
      {
        "command": "s-code.sendContext",
        "title": "S-Code: Send Current Editor Context"
      },
      {
        "command": "s-code.reviewDiff",
        "title": "S-Code: Review Changes Inline"
      },
      {
        "command": "s-code.reviewHunks",
        "title": "S-Code: Review and Reject Changes by Hunk"
      },
      {
        "command": "s-code.approve",
        "title": "S-Code: Approve Pending Tool Once"
      },
      {
        "command": "s-code.reject",
        "title": "S-Code: Reject Pending Tool"
      },
      {
        "command": "s-code.openWeb",
        "title": "S-Code: Open Local Web"
      }
    ],
    "configuration": {
      "title": "S-Code",
      "properties": {
        "s-code.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "description": "Loopback URL printed by s-code-daemon."
        },
        "s-code.organizationId": {
          "type": "string",
          "default": "org_local"
        },
        "s-code.teamId": {
          "type": "string",
          "default": "team_local"
        },
        "s-code.actorId": {
          "type": "string",
          "default": "user_local"
        },
        "s-code.defaultModel": {
          "type": "string",
          "default": "deepseek/deepseek-v4-flash"
        },
        "s-code.includeActiveDocument": {
          "type": "boolean",
          "default": true,
          "description": "Send the active document to the local daemon, subject to the context limit."
        },
        "s-code.maxDocumentBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 0,
          "maximum": 524288
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "s-code.ask",
          "group": "s-code@1",
          "when": "editorTextFocus"
        },
        {
          "command": "s-code.reviewDiff",
          "group": "s-code@2",
          "when": "editorTextFocus"
        },
        {
          "command": "s-code.reviewHunks",
          "group": "s-code@3",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "s-code.ask",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check approvals.js && node --check daemon-url.js && node --check protocol.js && node --check hunks.js && node --check test/run-extension-host.js && node --check test/extension-host/index.js && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:extension": "node test/run-extension-host.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2"
  }
}
