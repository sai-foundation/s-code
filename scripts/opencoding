#!/bin/sh
set -eu

BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

usage() {
  cat <<'EOF'
Opencoding

Usage:
  opencoding              Start the CLI
  opencoding cli          Start the CLI explicitly
  opencoding web          Start Local Web
  opencoding web [OPTION] Run a Local Web maintenance command
  opencoding update [VER] Verify and atomically install the latest or selected signed release
  opencoding --version    Print the CLI version
  opencoding --help       Show this help
EOF
}

case "${1:-}" in
  web)
    shift
    exec "$BIN_DIR/opencoding-daemon" "$@"
    ;;
  cli)
    shift
    exec "$BIN_DIR/opencoding-cli" "$@"
    ;;
  update)
    shift
    if [ "$#" -gt 1 ]; then
      echo "usage: opencoding update [VERSION]" >&2
      exit 2
    fi
    if [ "$#" -eq 1 ]; then
      case "$1" in
        -*|'') echo "VERSION must be a release tag such as v1.2.3" >&2; exit 2 ;;
      esac
      OPENCODING_VERSION="$1"
      export OPENCODING_VERSION
    fi
    exec "$BIN_DIR/opencoding-update"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    exec "$BIN_DIR/opencoding-cli" "$@"
    ;;
esac
