<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>S-Code third-party licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
    pre { border: 1px solid #bbb; max-height: 24rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <main>
    <h1>S-Code third-party licenses</h1>
    <p>This document contains the license notices for Rust dependencies included in the application.</p>
    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    <h2>License texts and components</h2>
    {{#each licenses}}
      {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
      <h4>{{name}}</h4>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    {{/each}}
  </main>
</body>
</html>
