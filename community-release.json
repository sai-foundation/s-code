{
  "schema_version": 3,
  "edition": "community",
  "product_name": "S-Code",
  "license": "Apache-2.0",
  "repository_identity": {
    "owner": "sl-7qx",
    "name": "s-code",
    "url": "https://github.com/sl-7qx/s-code",
    "initial_visibility": "private",
    "publication_visibility": "public",
    "publication_enabled": false
  },
  "source": {
    "authority": "community_repository",
    "repository_url": "https://github.com/sl-7qx/s-code",
    "default_branch": "main",
    "version_source": "Cargo.toml#workspace.package.version"
  },
  "source_revision_policy": {
    "require_clean_worktree": true,
    "require_full_git_revision": true,
    "require_reviewed_commit": true,
    "allow_dirty_release": false
  },
  "public_repository": {
    "required_files": [
      ".gitattributes",
      ".github/CODEOWNERS",
      ".github/ISSUE_TEMPLATE/bug_report.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/ISSUE_TEMPLATE/feature_request.yml",
      ".github/ISSUE_TEMPLATE/rfc.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/dependabot.yml",
      ".github/workflows/ci.yml",
      ".github/workflows/rc.yml",
      ".github/workflows/release.yml",
      ".gitignore",
      "CHANGELOG.md",
      "CODE_OF_CONDUCT.md",
      "CONTRIBUTING.md",
      "Cargo.lock",
      "Cargo.toml",
      "DCO",
      "GOVERNANCE.md",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "SUPPORT.md",
      "TRADEMARKS.md",
      "about.hbs",
      "about.toml",
      "community-release.json",
      "compliance/README.md",
      "compliance/baseline.json",
      "config/s-code.example.toml",
      "deny.toml",
      "docs-site/package-lock.json",
      "docs-site/package.json",
      "docs-site/scripts/generate-docs.mjs",
      "docs/README.md",
      "docs/deployment/preview-release.md",
      "rust-toolchain.toml",
      "s-code",
      "scripts/check-community-secrets.py",
      "scripts/check-community-tree.py",
      "scripts/check-dco.py",
      "scripts/check-doc-links.py",
      "scripts/ci-plan.py",
      "scripts/community-candidate.py",
      "scripts/configure-shell-path.py",
      "scripts/install-from-source.sh",
      "scripts/s-code",
      "scripts/verify-community.sh",
      "tests/README.md",
      "tests/benchmarks/harness/manifest.json",
      "tests/benchmarks/runner/package-lock.json",
      "tests/benchmarks/runner/package.json",
      "tests/cases/privacy-security-use-cases.jsonl",
      "tests/cases/transcript-reducer-conformance.json",
      "tests/cases/web-style-baseline.json",
      "tests/check-web-style.mjs",
      "tests/cli_pty_driver.py",
      "tests/model_fixture.py",
      "tests/test-ci-plan.py",
      "tests/test-ci-workflow.sh",
      "tests/test-cli-e2e.sh",
      "tests/test-community-candidate.sh",
      "tests/test-community-docs-site.sh",
      "tests/test-dco.sh",
      "tests/test-first-run.sh",
      "tests/test-harness-benchmark.py",
      "tests/test-harness-grader-integrity.sh",
      "tests/test-privacy-security-use-cases.sh",
      "tests/test-protocol-bindings.sh",
      "tests/test-source-install-real.sh",
      "tests/test-source-install.sh",
      "tests/test-shell-path.py",
      "tests/test-supply-chain.sh",
      "tests/test-verification.py",
      "tests/test-web-build.sh",
      "tests/test-web-style.sh"
    ],
    "required_directories": [
      ".github/workflows",
      "clients",
      "compliance",
      "config",
      "crates",
      "docs",
      "docs-site",
      "scripts",
      "tests",
      "web"
    ],
    "forbidden_integration_paths": [
      ".s-code",
      ".opencoding",
      ".openrouter_apikey",
      ".work",
      "AGENTS.md",
      "Dockerfile.control-plane",
      "Dockerfile.oidc-fixture",
      "config/enterprise-entitlement-claims.example.json",
      "config/s-code.control-plane.production.example.toml",
      "config/opencoding.control-plane.production.example.toml",
      "control-plane",
      "crates/agent-governance",
      "crates/control-plane",
      "crates/deployment-operator",
      "crates/entitlement-issuer",
      "crates/extension-runtime",
      "crates/microvm-platform",
      "crates/oidc-fixture",
      "crates/reference-enterprise",
      "deploy/airgap",
      "deploy/kubernetes/control-plane.yaml",
      "docs/enterprise",
      "docs/product/implementation-status.md",
      "docs/product/product-plan.md",
      "docs/product/repository-readiness-review.md",
      "output",
      "product-boundary.json",
      "product-delivery.json",
      "reference-enterprise",
      "release",
      "scripts/airgap_bundle.py",
      "scripts/enterprise_evaluation_kit.py",
      "target",
      "tests/test-airgap-bundle.sh",
      "tests/test-airgap-product-bundle.sh",
      "tests/test-enterprise-evaluation-kit.sh",
      "tests/test-postgres-ha.sh",
      "tests/test-postgres-pitr.sh",
      "tests/test-postgres-recovery.sh",
      "tests/test-postgres-upgrade.sh"
    ],
    "forbidden_license_identifiers": [
      "LicenseRef-S-Code-Enterprise",
      "LicenseRef-OpenCoding-Enterprise"
    ],
    "forbid_symlinks": true,
    "maximum_file_bytes": 10485760
  },
  "validation": {
    "pull_request": [
      "python3 scripts/check-community-tree.py",
      "python3 scripts/check-community-secrets.py --history",
      "python3 scripts/check-dco.py --base <base> --head <head>",
      "python3 scripts/check-doc-links.py",
      "tests/test-dco.sh",
      "tests/test-ci-workflow.sh",
      "tests/test-community-candidate.sh",
      "python3 tests/test-verification.py"
    ],
    "release_candidate": [
      "scripts/verify-community.sh",
      "tests/test-cli-e2e.sh",
      "tests/test-community-candidate.sh",
      "tests/test-source-install.sh",
      "tests/test-source-install-real.sh",
      "tests/test-verification.py",
      "tests/test-first-run.sh"
    ],
    "pull_request_strategy": "affected_areas",
    "required_pull_request_check": "source-gate",
    "routing_policy": "scripts/ci-plan.py",
    "full_verification_workflow": ".github/workflows/rc.yml",
    "release_qualification_profile": "full"
  },
  "source_release": {
    "strategy": "git_tag_and_attested_source_archive",
    "crates_io_publication_enabled": false,
    "prebuilt_artifacts_enabled": false,
    "binary_installer_enabled": false,
    "automatic_updater_enabled": false,
    "public_commands": [
      "s-code"
    ]
  },
  "governance": {
    "contribution_path": "community_repository_pull_request",
    "private_checks_gate_merges": false,
    "manual_copy_allowed": false,
    "reviewed_pull_request_required": true,
    "pre_publication_history_review_required": true,
    "rulesets_revalidated_after_visibility_change": true,
    "visibility_change_automation_allowed": false,
    "release_visibility_required": "public",
    "release_tags_created_in": "community_repository",
    "enterprise_consumption": "immutable_community_tag_or_full_revision"
  }
}
